{
  "name": "shopyaro-monorepo",
  "version": "1.0.0",
  "scripts": {
    "client": "npm run dev --prefix client",
    "server": "nodemon server/index.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm run build --prefix client"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.0"
  }
}