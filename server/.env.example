PORT=5000
NODE_ENV=development

# PostgreSQL Configuration
# You can provide DATABASE_URL (for cloud DB like Supabase, Neon, Railway, or local Postgres connection string):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shopyaro

# OR individual PostgreSQL credentials:
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=shopyaro

# JWT Authentication Secret
JWT_SECRET=shopyaro_super_secure_jwt_secret_key_2026
